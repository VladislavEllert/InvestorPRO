<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- T-Bank serves this API with a Russian Trusted Root CA certificate that iOS
	     does not trust. Without this exception ATS blocks the connection before
	     RussianTrustDelegate is even consulted. The connection stays HTTPS and the
	     delegate still enforces the pinned Russian root anchor. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>invest-public-api.tinkoff.ru</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
